      "parameters": {
        "jsCode": "let text = $json.output;\n\ntext = text\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nreturn [\n  {\n    json: JSON.parse(text)\n  }\n];"
