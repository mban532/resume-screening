      "id": "e7300ead-2b82-424e-9b7b-15e7836eec4d",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Skip invalid items\n  if (\n    !data.name ||\n    !data.email ||\n    data.score === undefined ||\n    !data.tier\n  ) {\n    continue;\n  }\n\n  const fitStatus = data.score >= 70 ? \"Fit\" : \"Not Fit\";\n\n  const selectionStatus =\n    data.score >= 70 ? \"Selected\" : \"Rejected\";\n\n  results.push({\n    json: {\n      name: data.name,\n      email: data.email,\n      score: data.score,\n      tier: data.tier,\n      reason: data.reason || \"\",\n      missing_skills: data.missing_skills || [],\n      fit_status: fitStatus,\n      selection_status: selectionStatus,\n    },\n  });\n}\n\nreturn items;"
      },
