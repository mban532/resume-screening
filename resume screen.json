    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      job_description: `Job Title: Java Backend Developer\n\nRequired Skills:\nJava\nSpring Boot\nSQL\nREST API\nGit\nDocker\n\nExperience:\n3+ Years`,\n\n      resume: `Name: Rahul Sharma\nEmail: rahul.sharma@gmail.com\n\nSkills:\nJava\nSpring Boot\nSQL\nREST API\nGit\nDocker\n\nExperience:\nSoftware Engineer - 4 Years\n\nEducation:\nB.Tech Computer Science`\n    }\n  },\n\n  {\n    json: {\n      job_description: `Job Title: Python Backend Developer\n\nRequired Skills:\nPython\nFlask\nDjango\nSQL\nDocker\n\nExperience:\n2+ Years`,\n\n      resume: `Name: Amit Kumar\nEmail: amit.kumar@gmail.com\n\nSkills:\nPython\nFlask\nSQL\nDocker\nGit\n\nExperience:\nPython Developer - 3 Years\n\nEducation:\nB.Tech Information Technology`\n    }\n  },\n\n  {\n    json: {\n      job_description: `Job Title: Data Analyst\n\nRequired Skills:\nSQL\nExcel\nPower BI\nPython\nStatistics\n\nExperience:\n2+ Years`,\n\n      resume: `Name: Priya Verma\nEmail: priya.verma@gmail.com\n\nSkills:\nSQL\nExcel\nPower BI\nPython\nStatistics\n\nExperience:\nData Analyst - 3 Years\n\nEducation:\nM.Sc Data Science`\n    }\n  },\n\n  {\n    json: {\n      job_description: `Job Title: DevOps Engineer\n\nRequired Skills:\nDocker\nKubernetes\nAWS\nLinux\nTerraform\n\nExperience:\n4+ Years`,\n\n      resume: `Name: Rohit Singh\nEmail: rohit.singh@gmail.com\n\nSkills:\nDocker\nKubernetes\nAWS\nLinux\nTerraform\nJenkins\n\nExperience:\nDevOps Engineer - 5 Years\n\nEducation:\nB.Tech Computer Science`\n    }\n  },\n\n  {\n    json: {\n      job_description: `Job Title: Full Stack Developer\n\nRequired Skills:\nReact\nNode.js\nExpress\nMongoDB\nJavaScript\n\nExperience:\n3+ Years`,\n\n      resume: `Name: Neha Gupta\nEmail: neha.gupta@gmail.com\n\nSkills:\nReact\nNode.js\nExpress\nMongoDB\nJavaScript\nHTML\nCSS\n\nExperience:\nFull Stack Developer - 4 Years\n\nEducation:\nB.Tech Computer Science`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
